# BEGIN 301 - Taxonomia reestruturada (2026-09-23)
# "Filmes e Seriados" (catch-all antigo) virou "Filmes"/"Séries"/"Programação
# da TV" + categorias de plataforma (Amazon Prime, Netflix, Globoplay,
# Telecine, Tela Quente, AppleTV+, Disney+) viraram tags únicas (consolida
# filme+série da mesma plataforma numa só URL, em vez de fragmentar em
# /filmes/netflix/ e /series/netflix/). "Livros e Quadrinhos" virou duas
# categorias separadas. Redirects cobrem tanto a URL hierárquica antiga
# (plataforma era filha de "Filmes e Seriados" na taxonomia do WP: /filmes-
# -e-seriados/netflix/) quanto a top-level que passou a existir depois que
# "Filmes e Seriados" foi deletada e o WP reparentou os filhos sozinho.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^filmes-e-seriados/?$ https://deveserisso.com.br/filmes/ [R=301,L]
RewriteRule ^filmes-e-seriados/amazon-prime/?$ https://deveserisso.com.br/tag/amazon-prime/ [R=301,L]
RewriteRule ^amazon-prime/?$ https://deveserisso.com.br/tag/amazon-prime/ [R=301,L]
RewriteRule ^filmes-e-seriados/netflix/?$ https://deveserisso.com.br/tag/netflix/ [R=301,L]
RewriteRule ^netflix/?$ https://deveserisso.com.br/tag/netflix/ [R=301,L]
RewriteRule ^filmes-e-seriados/globoplay/?$ https://deveserisso.com.br/tag/globoplay/ [R=301,L]
RewriteRule ^globoplay/?$ https://deveserisso.com.br/tag/globoplay/ [R=301,L]
RewriteRule ^filmes-e-seriados/telecine/?$ https://deveserisso.com.br/tag/telecine/ [R=301,L]
RewriteRule ^telecine/?$ https://deveserisso.com.br/tag/telecine/ [R=301,L]
RewriteRule ^filmes-e-seriados/tela-quente/?$ https://deveserisso.com.br/tag/tela-quente/ [R=301,L]
RewriteRule ^tela-quente/?$ https://deveserisso.com.br/tag/tela-quente/ [R=301,L]
RewriteRule ^filmes-e-seriados/appletv/?$ https://deveserisso.com.br/tag/appletv/ [R=301,L]
RewriteRule ^appletv/?$ https://deveserisso.com.br/tag/appletv/ [R=301,L]
RewriteRule ^filmes-e-seriados/disney/?$ https://deveserisso.com.br/tag/disney/ [R=301,L]
RewriteRule ^disney/?$ https://deveserisso.com.br/tag/disney/ [R=301,L]
RewriteRule ^futebol/?$ https://deveserisso.com.br/programacao-tv/ [R=301,L]
RewriteRule ^como-fazer/?$ https://deveserisso.com.br/filmes/ [R=301,L]
RewriteRule ^livros-e-quadrinhos/?$ https://deveserisso.com.br/livros/ [R=301,L]
</IfModule>
# END 301 - Taxonomia reestruturada

# BEGIN WebP Serve
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ /$1.webp [T=image/webp,E=webp:1,L]
</IfModule>
<IfModule mod_headers.c>
Header append Vary Accept env=webp
</IfModule>
# END WebP Serve

# AVIF sem MIME no servidor saia como text/plain; com o nosniff abaixo, o
# navegador bloqueia a imagem quando ela e carregada de fora do site (ORB),
# ex.: poster de John Wick 4 em branco no MCP App (2026-09-26).
<IfModule mod_mime.c>
AddType image/avif .avif
</IfModule>

# BEGIN Security Headers (H5 - Sprint 2026-07-12b)
# Q13 (2026-09-03): wp-admin precisa de 'unsafe-eval' no script-src -- o WP core
# usa _.template() (underscore.js -> new Function()) pra compilar templates do
# Backbone em telas nativas como o modal de Adicionar mídia, Customizer etc.
# Sem isso o CSP bloqueava o eval e o modal nunca abria. Restrito a
# /blog/wp-admin/ e /blog/wp-login.php via <If>/<Else> autocontido -- tentativa
# anterior com env var setada em <IfModule mod_rewrite.c> separado não
# funcionou (mesma classe de problema já visto antes: LiteSpeed não propagou
# a env var pro bloco <IfModule mod_headers.c> seguinte). O site público
# continua com o script-src estrito de antes.
<IfModule mod_headers.c>
<If "%{REQUEST_URI} =~ m#^/blog/(wp-admin|wp-login\.php)#">
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://image.tmdb.org https://www.themoviedb.org https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com.br https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; upgrade-insecure-requests"
</If>
<Else>
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://image.tmdb.org https://www.themoviedb.org https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com.br https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; upgrade-insecure-requests"
</Else>
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Frame-Options "SAMEORIGIN"
Header set Cross-Origin-Opener-Policy "same-origin"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
Header set X-XSS-Protection "1; mode=block"
</IfModule>
# END Security Headers

# Charset UTF-8 para arquivos de texto usados por agentes de IA
<Files "llms.txt">
AddCharset UTF-8 .txt
Header set Content-Type "text/plain; charset=utf-8"
</Files>

# API Catalog (RFC 9727) -- aponta pras APIs reais do site (WebMCP + WP REST API)
<Files "api-catalog">
Header set Content-Type 'application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"'
</Files>

# AI Catalog / ARD (Agentic Resource Discovery, agenticresourcediscovery.org)
# -- mesmo proposito do api-catalog acima (listar APIs reais do site), em
# formato diferente: especificacao multi-vendor (Microsoft/Google/Hugging
# Face/Linux Foundation e outros) ainda pre-1.0, pensada pra registries de
# agente indexarem via "representativeQueries" em vez de so seguir links.
# CORS aberto porque o consumidor e um registry de terceiro, nao o
# navegador do visitante -- nao ha dado sensivel nesse arquivo.
<Files "ai-catalog.json">
Header set Content-Type "application/json; charset=utf-8"
Header set Access-Control-Allow-Origin "*"
</Files>

# Agent Skills Discovery (agentskills.io / RFC draft v0.2.0) -- indice de
# skills reais publicadas em /.well-known/agent-skills/. SKILL.md e
# arquivo estatico servido direto pelo webserver (nao passa pelo
# dsi-ai-markdown.php, que so cobre post/pagina do WordPress), entao
# precisa do Content-Type explicito aqui, mesmo padrao do llms.txt.
<Files "SKILL.md">
Header set Content-Type "text/markdown; charset=utf-8"
</Files>
<Files "index.json">
Header set Access-Control-Allow-Origin "*"
</Files>

# WebMCP Server Card -- arquivos sem extensao (repo deveserisso-webmcp,
# deploy via FTP direto na raiz de .well-known/) nao tem MIME automatico
# de servidor pra JSON, entao a resposta saia sem nenhum Content-Type.
# Achado em 2026-09-07 ao avaliar observabilidade/legibilidade do site.
<FilesMatch "^(mcp|webmcp)$">
Header set Content-Type "application/json; charset=utf-8"
</FilesMatch>

# BEGIN Link Discovery Header (RFC 8288)
# "Header add" (nao "set") pra nao sobrescrever o Link rel="mcp" que o
# mu-plugin do WebMCP ja envia via PHP -- convivem como linhas Link
# separadas na mesma resposta. rel="api-catalog" e o unico tipo de
# relacao registrado no IANA aqui (RFC 9727); "mcp" e "llms.txt" sao
# convencoes informais, por isso mantidas como headers a parte.
<IfModule mod_headers.c>
Header add Link '<https://deveserisso.com.br/llms.txt>; rel="llms.txt"'
Header add Link '</.well-known/api-catalog>; rel="api-catalog"'
Header add Link '</.well-known/ai-catalog.json>; rel="ai-catalog"'
Header add Link '</.well-known/agent-skills/index.json>; rel="agent-skills"'
</IfModule>
# END Link Discovery Header

# BEGIN 301 - Posts sem audiencia removidos (2026-09-08)
# 22 posts com 0 cliques/impressoes no GSC nos ultimos 30 dias (06/08-05/09/2026),
# a maioria conteudo de evento datado e nao-recorrente (festivais GRLS/TUDUM 2020,
# eleicao Pixbet 2022, iGaming Summit 2022) ou fora do nicho editorial do site
# (viagens corporativas, plano de saude, redes de protecao). Redirecionados pra
# categoria tematica mais proxima quando existe; sem categoria correspondente, home.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^olympikus-corre-4/?$ https://deveserisso.com.br/tag/esportes/ [R=301,L]
RewriteRule ^promocao-black-friday-smartphones-com-descontos-especiais/?$ https://deveserisso.com.br/tag/tecnologia/ [R=301,L]
RewriteRule ^como-comparar-plano-de-saude/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^cinema-na-era-da-ia-e-do-seo-entre-algoritmos-autenticidade-e-ruido-digital/?$ https://deveserisso.com.br/filmes/ [R=301,L]
RewriteRule ^como-fotos-de-banco-de-imagens-podem-elevar-suas-campanhas-de-marrketing/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^pesquisa-mostra-que-brasileiros-confiam-na-classificacao-da-selecao-para-a-copa-do-mundo/?$ https://deveserisso.com.br/programacao-tv/ [R=301,L]
RewriteRule ^ataque-de-tubarao-brasil-e-o-4o-pais-com-mais-ataques/?$ https://deveserisso.com.br/tag/curiosidades/ [R=301,L]
RewriteRule ^redes-de-protecao-residenciais-dicas-para-contratar-o-servico-de-instalacao/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^brasileiros-conquistadores-panorama-dos-craques-no-exterior/?$ https://deveserisso.com.br/programacao-tv/ [R=301,L]
RewriteRule ^cinema-na-sala-de-aula-como-ele-pode-impactar-a-formacao-dos-alunos/?$ https://deveserisso.com.br/filmes/ [R=301,L]
RewriteRule ^como-se-planejar-estadia-prolongada-viagens-corporativas/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^gestao-de-viagens-corporativas/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^brazilian-igaming-summit-o-maior-evento-de-apostas-do-brasil/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^como-apostar-no-seu-candidato-a-presidencia-do-brasil-na-pixbet-entenda/?$ https://deveserisso.com.br/ [R=301,L]
RewriteRule ^onde-jogar-poker-online/?$ https://deveserisso.com.br/jogos/ [R=301,L]
RewriteRule ^20-atividades-para-distrair-as-criancas-em-epoca-de-quarentena/?$ https://deveserisso.com.br/dicas-e-tutoriais/ [R=301,L]
RewriteRule ^festival-grls-conheca-a-programacao-completa-do-espaco-gnt-talks/?$ https://deveserisso.com.br/tag/musica/ [R=301,L]
RewriteRule ^grls-tudo-que-voce-precisa-saber-para-aproveitar-o-festival-ao-maximo/?$ https://deveserisso.com.br/tag/musica/ [R=301,L]
RewriteRule ^vivo-celular-tudo-o-que-voce-precisa-saber-antes-de-contratar/?$ https://deveserisso.com.br/tag/tecnologia/ [R=301,L]
RewriteRule ^tudum-festival-saiba-todos-os-artistas-confirmados-para-o-evento/?$ https://deveserisso.com.br/tag/netflix/ [R=301,L]
RewriteRule ^grls-venda-de-ingressos-do-festival-iniciam-na-proxima-semana/?$ https://deveserisso.com.br/tag/musica/ [R=301,L]
