# BEGIN Really Simple Security Redirect
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteCond %{HTTP_USER_AGENT} !lscache_runner [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
# END Really Simple Security Redirect
# BEGIN Redirect - aprovados legado (N2, sprint 2026-08-02)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/aprovados-e-bom-e-vale-a-pena-assistir-confira-trailer-sinopse-e-mais/?$ https://deveserisso.com.br/aprovados/ [R=301,L]
</IfModule>
# END Redirect - aprovados legado
# BEGIN Blog to Root Redirects
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/?$ https://deveserisso.com.br/ [R=301,L]
RewriteCond %{REQUEST_URI} !^/blog/(wp-admin|wp-includes|wp-content|wp-json|wp-login\.php|wp-comments-post\.php|wp-cron\.php|wp-trackback\.php|wp-links-opml\.php|xmlrpc\.php)
RewriteRule ^blog/(.+)$ https://deveserisso.com.br/$1 [R=301,L]
</IfModule>
# END Blog to Root Redirects

# BEGIN 404 Fix - Pages
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^privacidade/?$ https://deveserisso.com.br/politicas-de-privacidade/ [R=301,L]
RewriteRule ^quem-somos/?$ https://deveserisso.com.br/sobre/ [R=301,L]
# /home/ e uma pagina orfa (resquicio de front page estatica antiga), duplicando
# a home real no Google como sitelink concorrente -- achado em 2026-09-06
RewriteRule ^home/?$ https://deveserisso.com.br/ [R=301,L]
# Aliases em ingles pras trust anchor pages -- achado via ora MCP (run_checks):
# o check "Trust anchor pages" sonda literalmente /about, /contact, /privacy
# (convencao em ingles) em vez de navegar pelos links do site em portugues.
RewriteRule ^about/?$ https://deveserisso.com.br/sobre/ [R=301,L]
RewriteRule ^contact/?$ https://deveserisso.com.br/contato/ [R=301,L]
RewriteRule ^privacy/?$ https://deveserisso.com.br/politicas-de-privacidade/ [R=301,L]
</IfModule>
# END 404 Fix - Pages

# BEGIN 301 - Slug sem ano (2026-09-08)
# post_title ja tinha o ano trocado pra 2026 (evergreen), slug antigo mantinha
# "-em-2020" -- removido pra ficar consistente com os outros posts da mesma
# serie (ex: melhores-series-de-acao-para-ver-na-netflix, sem ano no slug).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^melhores-series-policiais-para-ver-na-netflix-em-2020/?$ https://deveserisso.com.br/melhores-series-policiais-para-ver-na-netflix/ [R=301,L]
</IfModule>
# END 301 - Slug sem ano

