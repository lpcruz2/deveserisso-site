# BEGIN Really Simple Security Redirect
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteCond %{HTTP_USER_AGENT} !lscache_runner [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
# END Really Simple Security Redirect
# BEGIN Redirect - aprovados legado (N2, sprint 2026-08-02)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/aprovados-e-bom-e-vale-a-pena-assistir-confira-trailer-sinopse-e-mais/?$ https://deveserisso.com.br/aprovados/ [R=301,L]
</IfModule>
# END Redirect - aprovados legado
# BEGIN Blog to Root Redirects
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^blog/?$ https://deveserisso.com.br/ [R=301,L]
RewriteCond %{REQUEST_URI} !^/blog/(wp-admin|wp-includes|wp-content|wp-json|wp-login\.php|wp-comments-post\.php|wp-cron\.php|wp-trackback\.php|wp-links-opml\.php|xmlrpc\.php)
RewriteRule ^blog/(.+)$ https://deveserisso.com.br/$1 [R=301,L]
</IfModule>
# END Blog to Root Redirects

# BEGIN 404 Fix - Pages
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^privacidade/?$ https://deveserisso.com.br/politicas-de-privacidade/ [R=301,L]
RewriteRule ^quem-somos/?$ https://deveserisso.com.br/sobre/ [R=301,L]
# Aliases em ingles pras trust anchor pages -- achado via ora MCP (run_checks):
# o check "Trust anchor pages" sonda literalmente /about, /contact, /privacy
# (convencao em ingles) em vez de navegar pelos links do site em portugues.
RewriteRule ^about/?$ https://deveserisso.com.br/sobre/ [R=301,L]
RewriteRule ^contact/?$ https://deveserisso.com.br/contato/ [R=301,L]
RewriteRule ^privacy/?$ https://deveserisso.com.br/politicas-de-privacidade/ [R=301,L]
</IfModule>
# END 404 Fix - Pages

# BEGIN WebP Serve
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ /$1.webp [T=image/webp,E=webp:1,L]
</IfModule>
<IfModule mod_headers.c>
Header append Vary Accept env=webp
</IfModule>
# END WebP Serve

# BEGIN Security Headers (H5 - Sprint 2026-07-12b)
# Q13 (2026-09-03): wp-admin precisa de 'unsafe-eval' no script-src -- o WP core
# usa _.template() (underscore.js -> new Function()) pra compilar templates do
# Backbone em telas nativas como o modal de Adicionar mídia, Customizer etc.
# Sem isso o CSP bloqueava o eval e o modal nunca abria. Restrito a
# /blog/wp-admin/ e /blog/wp-login.php via <If>/<Else> autocontido -- tentativa
# anterior com env var setada em <IfModule mod_rewrite.c> separado não
# funcionou (mesma classe de problema já visto antes: LiteSpeed não propagou
# a env var pro bloco <IfModule mod_headers.c> seguinte). O site público
# continua com o script-src estrito de antes.
<IfModule mod_headers.c>
<If "%{REQUEST_URI} =~ m#^/blog/(wp-admin|wp-login\.php)#">
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://image.tmdb.org https://www.themoviedb.org https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com.br https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; upgrade-insecure-requests"
</If>
<Else>
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://image.tmdb.org https://www.themoviedb.org https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com.br https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; upgrade-insecure-requests"
</Else>
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Frame-Options "SAMEORIGIN"
Header set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
# END Security Headers

# Charset UTF-8 para arquivos de texto usados por agentes de IA
<Files "llms.txt">
AddCharset UTF-8 .txt
Header set Content-Type "text/plain; charset=utf-8"
</Files>

# API Catalog (RFC 9727) -- aponta pras APIs reais do site (WebMCP + WP REST API)
<Files "api-catalog">
Header set Content-Type 'application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"'
</Files>

# BEGIN Link Discovery Header (RFC 8288)
# "Header add" (nao "set") pra nao sobrescrever o Link rel="mcp" que o
# mu-plugin do WebMCP ja envia via PHP -- convivem como linhas Link
# separadas na mesma resposta. rel="api-catalog" e o unico tipo de
# relacao registrado no IANA aqui (RFC 9727); "mcp" e "llms.txt" sao
# convencoes informais, por isso mantidas como headers a parte.
<IfModule mod_headers.c>
Header add Link '<https://deveserisso.com.br/llms.txt>; rel="llms.txt"'
Header add Link '</.well-known/api-catalog>; rel="api-catalog"'
</IfModule>
# END Link Discovery Header

# BEGIN Markdown for Agents
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/(blog/)?(wp-admin|wp-includes|wp-content|wp-json)
RewriteRule ^(.+)\.md$ /$1/?dsi_markdown=1 [QSA,L]
</IfModule>
# END Markdown for Agents

# Block xmlrpc.php
<Files xmlrpc.php>
Order Deny,Allow
Deny from all
</Files>

# BEGIN WordPress
# As diretrizes (linhas) entre "BEGIN WordPress" e "END WordPress" são
# geradas dinamicamente e só devem ser modificadas através de filtros do WordPress.
# Quaisquer alterações nas diretivas entre esses marcadores serão sobrescritas.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# BEGIN Really Simple Security Disable directory indexing
# Disable directory indexing to prevent listing of directory contents
Options -Indexes
# END Really Simple Security Disable directory indexing
