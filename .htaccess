# END 301 - Posts sem audiencia removidos

# BEGIN Markdown for Agents
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/(blog/)?(wp-admin|wp-includes|wp-content|wp-json)
# Arquivo fisico .md ja existente (ex: .well-known/agent-skills/.../SKILL.md)
# nao deve ser roteado pro WordPress -- sem esta condicao, qualquer .md
# estatico em disco caia num 404 do WP (get_page_by_path() sem post
# correspondente), mesmo com o arquivo fisico presente no servidor.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.md$ /$1/?dsi_markdown=1 [QSA,L]
</IfModule>
# END Markdown for Agents

# Block xmlrpc.php
<Files xmlrpc.php>
Order Deny,Allow
Deny from all
</Files>

# BEGIN WordPress
# As diretrizes (linhas) entre "BEGIN WordPress" e "END WordPress" são
# geradas dinamicamente e só devem ser modificadas através de filtros do WordPress.
# Quaisquer alterações nas diretivas entre esses marcadores serão sobrescritas.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# BEGIN Really Simple Security Disable directory indexing
# Disable directory indexing to prevent listing of directory contents
Options -Indexes
# END Really Simple Security Disable directory indexing
